# Copy to .env only after the account owner has accepted provider terms.
# Never use a VITE_ prefix for secrets.
YOUCAM_API_KEY=
# `npm run youcam:check` may read the cost catalog with this key without enabling live renders.
# The legacy balance API needs a different access token; the helper never sends this key there.
# Both flags must be enabled deliberately. Local demo works without them.
YOUCAM_LIVE_ENABLED=false
YOUCAM_ALLOW_UNIT_USAGE=false
PORT=4818
